@model IEnumerable<th_lad_02.Models.MenuItem>

<nav class="sb-sidenav accordion sb-sidenav-dark" id="sidenavAccordion">
    <div class="sb-sidenav-menu">
        <div class="nav">
            <div class="sb-sidenav-menu-heading">Core</div>
            <a class="nav-link" href="/Student/Index">
                <div class="sb-nav-link-icon me-2"><i class="fas fa-tachometer-alt"></i></div>
                Dashboard
            </a>

            <div class="sb-sidenav-menu-heading">Addons</div>
            @foreach (var item in Model)
            {
                <a class="nav-link" href="@item.Link">
                    <div class="sb-nav-link-icon me-2"><i class="fa fa-chart-area"></i></div>
                    @item.Name
                </a>
            }
        </div>
    </div>
    <div class="sb-sidenav-footer">
        <div class="small">Logged in as:</div>
        Management System
    </div>
</nav>