@model IEnumerable<th_lad_06.Models.Learner>

@{
    ViewData["Title"] = "Index";
}

<div class="container mt-3">
    <h1>Learner List</h1>

    <!-- 1. Danh sách ngành học từ ViewComponent -->
    @await Component.InvokeAsync("Major")

    <!-- 2. Khung tìm kiếm học viên[cite: 28, 29] -->
    <div class="row my-3">
        <div class="col-md-5">
            <div class="input-group">
                <input id="keyword" class="form-control" name="keyword" type="text" placeholder="Search learner..." />
                <button id="btnSearch" class="btn btn-primary" type="button">
                    Search
                </button>
            </div>
        </div>
    </div>

    <!-- 3. Vùng content chứa bảng và phân trang nạp ban đầu[cite: 29] -->
    <div id="content">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Tên</th>
                    <th>Họ</th>
                    <th>Ngành</th>
                    <th>Ngày Nhập Học</th>
                    <th>Chức năng</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.LearnerID</td>
                        <td>@s.FirstMidName</td>
                        <td>@s.LastName</td>
                        <td>@s.Major?.MajorName</td>
                        <td>@s.EnrollmentDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@s.LearnerID" class="btn btn-warning btn-sm">Edit</a> |
                            <a asp-action="Delete" asp-route-id="@s.LearnerID" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Thanh phân trang cho trang 1 ban đầu[cite: 29] -->
        <ul class="pagination">
            @for (int i = 1; i <= ViewBag.pageNum; i++)
            {
                <li class="page-item"
                    page="@i"
                    @(ViewBag.mid != null ? $"mid={ViewBag.mid}" : "")
                    @(ViewBag.keyword != null ? $"keyword={ViewBag.keyword}" : "")>
                    <a class="page-link" href="javascript:void(0);">@i</a>
                </li>
            }
        </ul>
    </div>

    <p class="mt-3">
        <a asp-action="Create" class="btn btn-primary">Create New Student</a>
    </p>
</div>

@section Scripts {
    <script>
        // Bắt sự kiện click vào các nút phân trang[cite: 29]
        $('body').on('click', 'li.page-item', function (e) {
            e.preventDefault();
            var page = $(this).attr("page");
            var mid = $(this).attr("mid");
            var keyword = $(this).attr("keyword");

            var data = { mid: mid, keyword: keyword, pageIndex: page };
            $.ajax({
                url: "/Learner/LearnerFilter",
                data: data,
                success: function (response) {
                    $("div#content").html(response);
                }
            });
        });

        // Bắt sự kiện click chọn chuyên ngành[cite: 30]
        $(".nav li").click(function (e) {
            var id = $(this).attr("id");
            var data = { mid: id };
            $.ajax({
                url: "/Learner/LearnerFilter",
                data: data,
                success: function (response) {
                    $("div#content").html(response);
                }
            });
        });

        // Bắt sự kiện bấm nút Search[cite: 30]
        $("button#btnSearch").click(function (e) {
            var keyword = $("#keyword").val();
            var data = { keyword: keyword };
            $.ajax({
                url: "/Learner/LearnerFilter",
                data: data,
                success: function (response) {
                    $("div#content").html(response);
                }
            });
        });
    </script>
}