@model IEnumerable<lad_07_2.Models.Product>

<h2>Danh sách sản phẩm</h2>
<a asp-action="Create" class="btn btn-primary">Thêm mới</a>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Tên sản phẩm</th>
            <th>Giá</th>
            <th>Giá khuyến mãi</th>
            <th>Danh mục</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Price</td>
                <td>@item.SalePrice</td>
                <td>@item.Category?.Name</td>
            </tr>
        }
    </tbody>
</table>
