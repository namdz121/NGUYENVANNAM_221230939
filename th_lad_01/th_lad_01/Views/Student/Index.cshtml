@model IEnumerable<th_lad_01.Models.Student>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<a asp-controller="Student" asp-action="Create" class="btn btn-primary mb-3">Create Student</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Mã</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Ngành</th>
            <th>Giới tính</th>
            <th>Hệ ĐT</th>
            <th>Địa chỉ</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            string branchName = s.Branch switch
            {
                th_lad_01.Models.Branch.IT => "CNTT",
                th_lad_01.Models.Branch.BE => "Kinh tế",
                th_lad_01.Models.Branch.CE => "Công trình",
                th_lad_01.Models.Branch.EE => "Điện - Điện tử",
                _ => ""
            };

            <tr>
                <td>@s.Id</td>
                <td>@s.Name</td>
                <td>@s.DateOfBorth</td>
                <td>@branchName</td>
                <td>@(s.Gender == th_lad_01.Models.Gender.Male ? "Nam" : "Nữ")</td>
                <td>@(s.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                <td>@s.Address</td>
                <td>@s.Email</td>
            </tr>
        }
    </tbody>
</table>