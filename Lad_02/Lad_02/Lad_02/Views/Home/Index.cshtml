@model IEnumerable<Lad_02.Models.Product>
@{
    ViewData["Title"] = "Home Page";
}


<div class="jumbotron text-center">
    <h1>Microsoft Azure</h1>
    <p>Learn how Microsoft’s Azure cloud platform allows you to build, deploy, and scale web apps.</p>
    <a class="btn btn-primary" href="https://azure.microsoft.com">Learn More</a>
</div>


<h2>Danh sách sản phẩm</h2>
@if (Model != null && Model.Any())
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-3">
                <div class="card mb-4 shadow-sm">
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" />
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text">@item.Description</p>
                        <p class="card-text text-danger">@item.Price.ToString("C")</p>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>Không có sản phẩm nào để hiển thị.</p>
}