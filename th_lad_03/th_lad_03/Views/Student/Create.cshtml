@model th_lad_03.Models.Student

@{
    ViewData["Title"] = "Thêm mới sinh viên";
}

<h2>Thêm mới sinh viên</h2>

<!-- Hiển thị tổng hợp lỗi nếu có -->
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<form asp-controller="Student" asp-action="Create" method="post" class="mt-3">
    <!-- Họ tên -->
    <div class="form-group row mb-3">
        <label asp-for="Name" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Name" class="form-control" placeholder="Nhập họ tên" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>

    <!-- Email -->
    <div class="form-group row mb-3">
        <label asp-for="Email" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Email" class="form-control" placeholder="Nhập email (@@gmail.com)" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
    </div>

    <!-- Mật khẩu -->
    <div class="form-group row mb-3">
        <label asp-for="Password" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
    </div>

    <!-- Điểm -->
    <div class="form-group row mb-3">
        <label asp-for="Score" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Score" type="number" step="0.1" class="form-control" placeholder="Nhập điểm (0.0 - 10.0)" />
            <span asp-validation-for="Score" class="text-danger"></span>
        </div>
    </div>

    <!-- Ngành học -->
    <div class="form-group row mb-3">
        <label asp-for="Branch" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <select asp-for="Branch" class="form-select" asp-items="ViewBag.AllBranches">
                <option value="">-- Chọn ngành học --</option>
            </select>
            <span asp-validation-for="Branch" class="text-danger"></span>
        </div>
    </div>

    <!-- Giới tính -->
    <div class="form-group row mb-3">
        <label asp-for="Gender" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            @foreach (var gender in ViewBag.AllGenders)
            {
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="Gender" value="@gender" id="Gender_@gender" />
                    <label class="form-check-label" for="Gender_@gender">@gender</label>
                </div>
            }
            <div>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- Ngày sinh -->
    <div class="form-group row mb-3">
        <label asp-for="DateOfBorth" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="DateOfBorth" class="form-control" />
            <span asp-validation-for="DateOfBorth" class="text-danger"></span>
        </div>
    </div>

    <!-- Hệ chính quy -->
    <div class="form-group row mb-3">
        <label asp-for="IsRegular" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10 d-flex align-items-center">
            <input class="form-check-input" type="checkbox" asp-for="IsRegular" />
            <span asp-validation-for="IsRegular" class="text-danger ms-2"></span>
        </div>
    </div>

    <!-- Địa chỉ -->
    <div class="form-group row mb-3">
        <label asp-for="Address" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <textarea asp-for="Address" class="form-control" rows="3" placeholder="Nhập địa chỉ"></textarea>
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>
    </div>

    <!-- Nút Submit -->
    <div class="form-group row mt-4">
        <div class="col-sm-10 offset-sm-2">
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </div>
</form>

<!-- Kích hoạt Client-side Validation (nếu có thư viện jQuery Validation trong layout) -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}